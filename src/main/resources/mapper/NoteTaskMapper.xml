<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.study.kgraph.mapper.NoteTaskMapper">
  <resultMap id="NoteTaskMap" type="com.study.kgraph.entity.NoteTask">
    <id property="id" column="id"/>
    <result property="noteId" column="note_id"/>
    <result property="taskId" column="task_id"/>
    <result property="status" column="status"/>
    <result property="createdAt" column="created_at"/>
    <result property="updatedAt" column="updated_at"/>
  </resultMap>
  <insert id="insert" useGeneratedKeys="true" keyProperty="id">
    INSERT INTO note_tasks(note_id, task_id, status) VALUES(#{noteId}, #{taskId}, #{status})
  </insert>
  <update id="updateStatus">
    UPDATE note_tasks SET status = #{status} WHERE task_id = #{taskId}
  </update>
  <select id="findByTaskId" resultMap="NoteTaskMap">
    SELECT * FROM note_tasks WHERE task_id = #{taskId}
  </select>
  <select id="findByNoteId" resultMap="NoteTaskMap">
    SELECT * FROM note_tasks WHERE note_id = #{noteId} ORDER BY id DESC LIMIT 1
  </select>
  <select id="findAll" resultMap="NoteTaskMap">
    SELECT * FROM note_tasks ORDER BY id DESC LIMIT 20
  </select>
</mapper>
