<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.study.kgraph.mapper.CategoryMapper">
    <resultMap id="CategoryMap" type="com.study.kgraph.entity.Category">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="name" column="name"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO categories(user_id, name) VALUES(#{userId}, #{name})
    </insert>

    <select id="findByUserId" resultMap="CategoryMap">
        SELECT * FROM categories WHERE user_id = #{userId} ORDER BY name ASC
    </select>

    <select id="findById" resultMap="CategoryMap">
        SELECT * FROM categories WHERE id = #{id}
    </select>

    <select id="findByUserIdAndName" resultMap="CategoryMap">
        SELECT * FROM categories WHERE user_id = #{userId} AND name = #{name} LIMIT 1
    </select>

    <update id="updateName">
        UPDATE categories SET name = #{name} WHERE id = #{id}
    </update>

    <delete id="delete">
        DELETE FROM categories WHERE id = #{id}
    </delete>
</mapper>
