<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.study.kgraph.mapper.NoteVersionMapper">
  <resultMap id="NoteVersionMap" type="com.study.kgraph.entity.NoteVersion">
    <id property="id" column="id"/>
    <result property="noteId" column="note_id"/>
    <result property="versionNumber" column="version_number"/>
    <result property="title" column="title"/>
    <result property="text" column="text"/>
    <result property="summary" column="summary"/>
    <result property="createdAt" column="created_at"/>
    <result property="updatedAt" column="updated_at"/>
  </resultMap>

  <insert id="insert" useGeneratedKeys="true" keyProperty="id">
    INSERT INTO note_versions(note_id, version_number, title, text, summary)
    VALUES(
      #{noteId},
      (SELECT IFNULL(MAX(v.version_number), 0) + 1 FROM note_versions v WHERE v.note_id = #{noteId}),
      #{title},
      #{text},
      #{summary}
    )
  </insert>

  <select id="findMetaByNoteId" resultMap="NoteVersionMap">
    SELECT *
    FROM note_versions
    WHERE note_id = #{noteId}
    ORDER BY version_number DESC, id DESC
    LIMIT 50
  </select>

  <select id="findById" resultMap="NoteVersionMap">
    SELECT *
    FROM note_versions
    WHERE id = #{id}
  </select>
</mapper>
