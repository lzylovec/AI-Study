<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.study.kgraph.mapper.NoteVersionMapper">
  <resultMap id="NoteVersionMap" type="com.study.kgraph.entity.NoteVersion">
    <id property="id" column="id"/>
    <result property="noteId" column="note_id"/>
    <result property="userId" column="user_id"/>
    <result property="title" column="title"/>
    <result property="text" column="text"/>
    <result property="summary" column="summary"/>
    <result property="audioPath" column="audio_path"/>
    <result property="opType" column="op_type"/>
    <result property="createdAt" column="created_at"/>
  </resultMap>

  <insert id="insert" useGeneratedKeys="true" keyProperty="id">
    INSERT INTO note_versions(note_id, user_id, title, text, summary, audio_path, op_type)
    VALUES(#{noteId}, #{userId}, #{title}, #{text}, #{summary}, #{audioPath}, #{opType})
  </insert>

  <select id="findMetaByNoteId" resultMap="NoteVersionMap">
    SELECT *
    FROM note_versions
    WHERE note_id = #{noteId}
    ORDER BY id DESC
    LIMIT 50
  </select>

  <select id="findById" resultMap="NoteVersionMap">
    SELECT *
    FROM note_versions
    WHERE id = #{id}
  </select>
</mapper>
