<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.study.kgraph.mapper.ConceptMapper">
  <insert id="insertBatch">
    INSERT INTO concepts(user_id, name, score)
    <foreach collection="list" item="c" separator=",">
      (#{c.userId}, #{c.name}, #{c.score})
    </foreach>
  </insert>
  <select id="findByUserId" resultType="com.study.kgraph.entity.Concept">
    SELECT id, user_id as userId, name, score FROM concepts WHERE user_id = #{userId}
  </select>
</mapper>
